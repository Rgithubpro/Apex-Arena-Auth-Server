# ---- Copy to .env for local development. On Render, set these in the dashboard. ----

# Database (the same Turso database as the data server; auth tables are prefixed auth_)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Websites allowed to call this server (origins only, comma separated, no wildcard)
ALLOWED_ORIGINS=

# This server's own public address (used for OAuth redirects and token checks)
PUBLIC_URL=

# Render sits behind one proxy
TRUST_PROXY_HOPS=1

# Generate these three with:  npm run generate-keys
AUTH_JWT_PRIVATE_KEY=
GAME_SERVER_SECRET=
ADMIN_API_KEY=
# Local development only: requests carrying this skip the CLOCK check of their proof (nothing else).
# Put the same value in js/data/dev-key.js on your own machine. Leave it out if you do not need it.
DEV_BYPASS_KEY=

# Third-party logins: each one is switched on only when both values are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# Steam needs no credentials, just this switch:
STEAM_ENABLED=true
# Hide providers without removing their credentials (switch one off and on from the Render dashboard):
DISABLED_PROVIDERS=roblox

# ---- Optional tunables (defaults shown) ----
ACCESS_TTL_SECONDS=1800          # longer = fewer refreshes = fewer database reads/writes
SESSION_TTL_DAYS=60
SESSION_MAX_DAYS=180
GUEST_INACTIVITY_DAYS=180
GUEST_CREATES_PER_IP_PER_DAY=2
USERNAME_RULES_REFRESH_SECONDS=60   # how often the username filter checks Turso for rule changes
TOS_VERSION=1                    # bump to make everyone accept new terms
MAIL_PROVIDER=                   # set when e-mail sending is implemented
